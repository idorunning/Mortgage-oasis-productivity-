# Copy to .env and edit. The .env file is git-ignored.

# Where the app reads data from: sheets | csv | markdown
DATA_SOURCE=sheets

# --- sheets mode (live Google Sheets) ---
# The spreadsheet id (from its URL: /spreadsheets/d/<THIS>/edit)
SHEET_ID=1HjYk4Ybfl4t2C5boObdKzABqpBTA04wIpB0wxwkX2mU
# A1 range or a tab name. Leave wide to capture all stacked tables.
SHEET_RANGE=A1:Z5000
# Path to the service-account JSON key you downloaded from Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# --- csv mode (offline export: File > Download > CSV) ---
DATA_CSV=./export.csv

# --- markdown mode (developer/testing) ---
DATA_MARKDOWN=./export.md

# Seconds to cache an analysis before re-pulling (Refresh button always re-pulls)
CACHE_TTL=300
PORT=5000
